<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input type="text" id="title" name="title" maxlength="200" required value="<%= project.title %>" />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" maxlength="999" required><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" maxlength="199" required value="<%= project.location %>" />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                required
                value="<%= typeof project.date === 'string' ? project.date.slice(0, 10) : new Date(project.date).toISOString().split('T')[0] %>"
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <% organizations.forEach((organization) => { %>
                    <option
                        value="<%= organization.organization_id %>"
                        <%= String(organization.organization_id) === String(project.organization_id) ? 'selected' : '' %>
                    >
                        <%= organization.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <button type="submit">Update Project</button>
    </form>
</main>
<%- include('partials/footer') %>