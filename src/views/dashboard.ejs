<%- include('partials/header') %>

<main>
    <h1>
        <%= title %>
    </h1>

    <p>Name: <%= name %>
    </p>
    <p>Username: <%= email %>
    </p>

    <h2>My Volunteer Projects</h2>

    <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
        <ul>
            <% volunteeredProjects.forEach((project) => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                    <span> - </span>
                    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    <span> - </span>
                    <%= new Date(project.date).toLocaleDateString('en-US') %>
                    <span> - </span>
                    <a href="/project/<%= project.project_id %>/unvolunteer?redirect=dashboard">Remove myself as a volunteer</a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>You have not signed up to volunteer for any projects yet.</p>
    <% } %>
</main>

<%- include('partials/footer') %>